name: Generate Snake Animation

on:
  schedule:
    - cron: "0 */6 * * *" 
  workflow_dispatch:
  push:
    branches:
    - main
    - master

permissions:
  contents: write

jobs:
  generate:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    
    steps:
      - name: Generate github-contribution-grid-snake.svg
        uses: Platane/snk/svg-only@v3
        with:
          github_user_name: ${{ github.repository_owner }}
          # This is where the magic happens! We changed color_snake to red (#FF0000)
          # We also set custom dot colors ranging from black (empty) to bright green (many commits)
          outputs: |
            dist/github-contribution-grid-snake.svg?color_snake=#FF0000&color_dots=#161b22,#003d16,#006d21,#009e33,#00FF99
            dist/github-contribution-grid-snake-dark.svg?palette=github-dark&color_snake=#FF0000&color_dots=#161b22,#003d16,#006d21,#009e33,#00FF99
          
      - name: Push github-contribution-grid-snake.svg to the output branch
        uses: crazy-max/ghaction-github-pages@v3.1.0
        with:
          target_branch: output
          build_dir: dist
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
